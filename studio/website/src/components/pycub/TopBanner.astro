---
import { translations, getRoutePrefix, type Locale } from "@/i18n/translations";
import { ArrowRight, Sparkles } from "@lucide/astro";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const t = translations[lang];
const prefix = getRoutePrefix(lang);
---

<div class="site-container px-4 xl:px-0 mt-2 mb-4" data-aos="fade-down-xs" data-aos-once="true">
  <div class="relative overflow-hidden rounded-2xl border border-primary/20 dark:border-primary-light/20 bg-gradient-to-r from-primary/[0.08] via-indigo-500/[0.07] to-accent/[0.10] dark:from-primary/20 dark:via-indigo-950/60 dark:to-violet-950/40 px-4 py-2.5 sm:px-5 sm:py-3 shadow-xs">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-2 text-xs sm:text-sm">
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2.5 text-center sm:text-left">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-primary text-white font-semibold text-[11px] tracking-wide shadow-xs flex-shrink-0">
          <Sparkles class="w-3 h-3" />
          {t.banner.badge}
        </span>
        <span class="text-neutral-700 dark:text-neutral-200 font-medium">
          {t.banner.text}
        </span>
      </div>
      <a
        href={`${prefix}/downloads`}
        class="inline-flex items-center gap-1 font-semibold text-primary dark:text-primary-light hover:underline whitespace-nowrap flex-shrink-0"
      >
        <span>{t.banner.cta}</span>
        <ArrowRight class="w-3.5 h-3.5" />
      </a>
    </div>
  </div>
</div>
