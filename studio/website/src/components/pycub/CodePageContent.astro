---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";
import CodePlayground from "@/components/pycub/CodePlayground.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import { translations, type Locale } from "@/i18n/translations";
import { Code } from "astro:components";
import { Download, BookOpen, ExternalLink } from "@lucide/astro";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const t = translations[lang];
const page = t.pages.code;
const handbookUrl = lang === "cs" ? siteConfig.links.handbookCs : siteConfig.links.handbookEn;

const skinExampleCode = `from icub_pybullet.pycub import pyCub

def main():
    # skin_test.yaml spawns balls above iCub and visualizes active taxels in green
    client = pyCub(config="skin_test.yaml")

    while client.is_alive():
        client.update_simulation(None)

if __name__ == "__main__":
    main()`;
---

<Layout title={t.meta.codeTitle} description={t.meta.codeDesc} lang={lang}>
  <section class="site-container my-10">
    <PageHeader title={page.heading} description={page.subheading} tags={page.tags} />
  </section>

  <!-- Interactive Tabbed Code Playground -->
  <section class="site-container pb-16">
    <CodePlayground lang={lang} />
  </section>

  <!-- Bilingual kid_api Command Table -->
  <section class="site-container py-12">
    <SectionHeader title={page.kidApiTitle} description={page.kidApiDesc} />
    <div
      class="mt-6 rounded-2xl overflow-hidden border border-primary/15 dark:border-neutral-700 bg-bg-secondary dark:bg-bg-secondary-dark shadow-sm"
      data-aos="fade-up-sm"
      data-aos-once="true"
    >
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-primary/15 dark:border-neutral-700 bg-bg-primary/60 dark:bg-neutral-900/60 text-xs uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
              <th class="py-3.5 px-4 sm:px-6 font-semibold">{page.colEn}</th>
              <th class="py-3.5 px-4 sm:px-6 font-semibold">{page.colCs}</th>
              <th class="py-3.5 px-4 sm:px-6 font-semibold">{page.colDesc}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-200/70 dark:divide-neutral-800 text-xs sm:text-sm">
            {page.kidCommands.map((row) => (
              <tr class="hover:bg-primary/[0.03] dark:hover:bg-primary/[0.06] transition-colors">
                <td class="py-3 px-4 sm:px-6 font-mono text-primary dark:text-primary-light whitespace-nowrap">
                  {row.en}
                </td>
                <td class="py-3 px-4 sm:px-6 font-mono text-emerald-700 dark:text-emerald-400 whitespace-nowrap">
                  {row.cs}
                </td>
                <td class="py-3 px-4 sm:px-6 text-neutral-600 dark:text-neutral-300">
                  {row.desc}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Skin Example Snippet -->
  <section class="site-container py-10">
    <div class="max-w-4xl mx-auto rounded-2xl overflow-hidden border border-primary/15 dark:border-neutral-700 bg-[#0d1117] shadow-lg">
      <div class="flex items-center justify-between px-4 py-3 bg-neutral-900 border-b border-neutral-800">
        <span class="text-xs font-mono text-primary-light">icub_pybullet/examples/skin_test.py</span>
        <Badge variant="primary" size="sm">Tactile Skin</Badge>
      </div>
      <div class="p-4 sm:p-5 text-xs sm:text-[13px] overflow-x-auto skin-code-block">
        <Code code={skinExampleCode} lang="python" theme="github-dark" />
      </div>
    </div>
  </section>

  <!-- Course Exercises 1-5 -->
  <section class="site-container py-12 md:py-16">
    <SectionHeader title={page.exercisesTitle} description={page.exercisesDesc} />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mt-8">
      {page.exercises.map((ex, i) => (
        <div
          class="p-6 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/15 dark:border-neutral-700 flex flex-col justify-between gap-4"
          data-aos="fade-up-sm"
          data-aos-delay={i * 75}
          data-aos-once="true"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <Badge variant="primary">Exercise {ex.num}</Badge>
              <span class="text-[11px] font-medium text-neutral-400 dark:text-neutral-500">{ex.skills}</span>
            </div>
            <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-2">{ex.title}</h3>
            <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">{ex.summary}</p>
          </div>
          <code class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400">
            exercises/exercise_{ex.num}/
          </code>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <Button url={siteConfig.links.exercisesZip} type="fill" target="_blank">
        <Download size={16} /> exercises.zip
      </Button>
      <Button url={handbookUrl} type="solid" target="_blank">
        <BookOpen size={16} /> {t.finalCta.secondary} <ExternalLink size={14} />
      </Button>
    </div>
  </section>
</Layout>

<style>
  .skin-code-block :global(pre.astro-code) {
    background: transparent !important;
    margin: 0 !important;
    padding: 0 !important;
  }
</style>
