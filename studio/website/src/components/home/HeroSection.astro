---
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import AnimatedText from "@/components/ui/AnimatedText.astro";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";
import { siteConfig, releaseAssets } from "@/config/site";
import { translations, getRoutePrefix, type Locale } from "@/i18n/translations";
import { ArrowRight, Check, Copy, Download, Terminal, Code, ExternalLink, Layers } from "@lucide/astro";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const t = translations[lang];
const prefix = getRoutePrefix(lang);
const heroImgLight = "/assets/screenshots/normal-ide.png";
const heroImgDark = "/assets/screenshots/normal-ide-dark.png";
const scratchThumb = lang === "cs" ? "/assets/screenshots/kid-scratch-cs.png" : "/assets/screenshots/kid-scratch.png";
---

<section class="relative site-container z-20 w-full mx-auto mt-6 px-4 md:mt-10 lg:mt-14 xl:px-0">
  <div class="relative w-full flex flex-col items-center justify-between gap-10 lg:flex-row mb-10">
    <!-- Left: Copy + Standalone Binary Chips + Copyable pip bar + CTAs -->
    <div class="relative w-full lg:w-[46%] text-center lg:text-left">
      <div
        class="flex flex-wrap gap-2 justify-center lg:justify-start mb-5"
        data-aos="fade-up-xs"
        data-aos-delay="50"
        data-aos-duration="450"
        data-aos-once="true"
      >
        <Badge variant="primary">{t.hero.badges[0]}</Badge>
        <Badge variant="neutral">{t.hero.badges[1]}</Badge>
        <Badge variant="accent">{t.hero.badges[2]}</Badge>
        <Badge variant="warning">{t.beta.badge}</Badge>
      </div>

      <h1 class="mb-5">
        <AnimatedText
          content={t.hero.title}
          delay={0.08}
          duration={0.45}
          stagger={0.05}
          class="text-4xl leading-[1.08] sm:text-5xl lg:text-[3.4rem] font-brand text-neutral-900 dark:text-neutral-50"
        />
      </h1>

      <div class="mb-6">
        <AnimatedText
          content={t.hero.subtitle}
          delay={0.25}
          duration={0.45}
          stagger={0.012}
          class="text-base sm:text-[17px] text-neutral-600 dark:text-neutral-300 leading-relaxed"
        />
      </div>

      <!-- 1) Direct Latest-Release Binary Downloads (No Python Required) -->
      <div
        class="mb-4 space-y-2"
        data-aos="fade-up-xs"
        data-aos-delay="330"
        data-aos-once="true"
      >
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2 text-xs font-medium text-neutral-600 dark:text-neutral-300">
          <span>{t.hero.binariesLabel}</span>
          <a
            href={siteConfig.links.releasesLatest}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-mono bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light hover:underline"
          >
            <span class="release-latest-tag">{siteConfig.releaseTag}</span>
          </a>
        </div>
        <div class="flex flex-wrap gap-2 justify-center lg:justify-start">
          {t.hero.binaryChips.map((chip) => {
            const asset = releaseAssets[chip.assetKey as keyof typeof releaseAssets];
            return (
              <a
                href={asset ? asset.url : siteConfig.links.releasesLatest}
                data-release-asset={chip.assetKey}
                title={asset ? `${asset.filename} (${asset.size})` : undefined}
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/20 dark:border-neutral-700 hover:border-primary text-xs font-medium text-neutral-800 dark:text-neutral-100 shadow-xs transition-all hover:-translate-y-0.5"
              >
                <Download class="w-3.5 h-3.5 text-primary dark:text-primary-light flex-shrink-0" />
                <span>{chip.label}</span>
                <span class="font-mono text-[11px] text-primary dark:text-primary-light">{chip.ext}</span>
              </a>
            );
          })}
          <a
            href={`${prefix}/downloads#binaries`}
            class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-dashed border-primary/30 dark:border-neutral-600 hover:border-primary text-[11px] font-medium text-neutral-600 dark:text-neutral-300 hover:text-primary dark:hover:text-primary-light transition-colors"
          >
            <span>{t.hero.allBuildsChip}</span>
          </a>
        </div>
      </div>

      <!-- 2) Sleek Copyable pip install bar -->
      <div
        class="mb-7 flex flex-col items-center lg:items-start gap-1.5"
        data-aos="fade-up-xs"
        data-aos-delay="380"
        data-aos-once="true"
      >
        <div class="text-[11px] text-neutral-500 dark:text-neutral-400">
          {t.hero.pipAltLabel}
        </div>
        <button
          type="button"
          class="copy-install-btn group inline-flex items-center gap-3 px-4 py-2.5 rounded-xl bg-neutral-900 dark:bg-neutral-950 text-neutral-100 border border-neutral-700/80 shadow-sm hover:border-primary/70 transition-all cursor-pointer"
          data-copy="pip install pycub-studio"
          data-label-default={t.hero.copyCmdLabel}
          data-label-copied={t.hero.copiedLabel}
        >
          <Terminal class="w-4 h-4 text-primary-light flex-shrink-0" />
          <code class="text-xs sm:text-sm font-mono tracking-tight text-neutral-100">$ pip install pycub-studio</code>
          <span class="inline-flex items-center gap-1 pl-2 border-l border-neutral-700 text-xs text-neutral-400 group-hover:text-white transition-colors">
            <Copy class="w-3.5 h-3.5 copy-icon" />
            <Check class="w-3.5 h-3.5 text-emerald-400 hidden check-icon" />
            <span class="copy-feedback hidden sm:inline">{lang === "cs" ? "Kopírovat" : "Copy"}</span>
          </span>
        </button>
      </div>

      <!-- CTAs -->
      <div
        class="flex flex-wrap gap-3 justify-center lg:justify-start"
        data-aos="fade-up-sm"
        data-aos-delay="450"
        data-aos-once="true"
      >
        <Button url={`${prefix}/downloads`} type="fill" size="md">
          <Download size={16} /> {t.hero.primaryCta}
        </Button>
        <Button url="#modes" type="solid" size="md">
          <Layers size={16} /> {t.hero.secondaryCta} <ArrowRight size={15} />
        </Button>
        <Button url={`${prefix}/code`} type="outline" size="md">
          <Code size={16} /> {t.hero.tertiaryCta}
        </Button>
      </div>

      <!-- Beta & Maintainer Contact Note -->
      <p
        class="mt-4 text-xs text-neutral-500 dark:text-neutral-400 flex flex-wrap items-center justify-center lg:justify-start gap-x-1.5 gap-y-1"
        data-aos="fade-up-xs"
        data-aos-delay="500"
        data-aos-once="true"
      >
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-500 flex-shrink-0"></span>
        <span>{t.beta.shortNote}</span>
        <a
          href={siteConfig.links.githubIssues}
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-primary dark:text-primary-light hover:underline"
        >
          GitHub
        </a>
        <span>{lang === "cs" ? "nebo" : "or"}</span>
        <a
          href={`mailto:${siteConfig.mail}`}
          class="font-medium text-primary dark:text-primary-light hover:underline"
        >
          {siteConfig.mail}
        </a>
      </p>
    </div>

    <!-- Right: Real Studio Screenshot (adapts automatically to Light / Dark website mode) -->
    <div
      class="relative w-full lg:w-[54%]"
      data-aos="fade-left-sm"
      data-aos-delay="200"
      data-aos-duration="700"
      data-aos-once="true"
    >
      <BrowserFrame url={t.hero.frameTitle} className="w-full shadow-xl">
        <div class="relative bg-neutral-950 overflow-hidden group">
          <img
            src={heroImgLight}
            alt={t.hero.frameTitle}
            width="1440"
            height="900"
            loading="eager"
            class="w-full h-auto block dark:hidden object-cover transition-transform duration-500 group-hover:scale-[1.01]"
          />
          <img
            src={heroImgDark}
            alt={`${t.hero.frameTitle} (Dark)`}
            width="1440"
            height="900"
            loading="eager"
            class="w-full h-auto hidden dark:block object-cover transition-transform duration-500 group-hover:scale-[1.01]"
          />
          <!-- Secondary floating Blockly preview badge on large screens -->
          <a
            href="#modes"
            class="hidden sm:flex items-center gap-2.5 absolute bottom-3 left-3 right-3 sm:right-auto bg-white/92 dark:bg-neutral-900/92 backdrop-blur-md border border-primary/20 dark:border-neutral-700 rounded-xl p-2 shadow-lg hover:border-primary transition-colors max-w-xs"
          >
            <img
              src={scratchThumb}
              alt="Blockly Scratch mode preview"
              width="120"
              height="75"
              class="w-16 h-10 rounded-md object-cover border border-neutral-200 dark:border-neutral-700 flex-shrink-0"
            />
            <div class="min-w-0">
              <div class="text-[11px] font-semibold text-neutral-800 dark:text-neutral-100 truncate">
                {lang === "cs" ? "5 režimů v jednom okně" : "5 modes in one window"}
              </div>
              <div class="text-[10px] text-neutral-500 dark:text-neutral-400 truncate">
                {lang === "cs" ? "Tlačítka · Blockly · Python · IDE · Web" : "Buttons · Blockly · Python · IDE · Web"}
              </div>
            </div>
          </a>
        </div>
      </BrowserFrame>
      <p class="text-xs text-neutral-400 dark:text-neutral-500 mt-3 text-center lg:text-right">
        {t.hero.frameCaption}
      </p>
    </div>
  </div>

  <!-- Signature pyCub Showcase Banner with iCub Render & Quick Links -->
  <div
    class="relative overflow-hidden rounded-2xl border border-primary/20 dark:border-primary-light/20 bg-gradient-to-br from-slate-900 via-[#0f1c34] to-[#1a1336] text-white p-5 sm:p-7 shadow-lg mb-8"
    data-aos="fade-up-sm"
    data-aos-once="true"
  >
    <div class="pointer-events-none absolute -right-10 -top-10 w-64 h-64 rounded-full bg-primary/25 blur-3xl"></div>
    <div class="pointer-events-none absolute -left-10 -bottom-10 w-64 h-64 rounded-full bg-violet-500/20 blur-3xl"></div>

    <div class="relative flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex flex-col sm:flex-row items-center gap-5 text-center sm:text-left">
        <div class="relative flex-shrink-0 w-24 h-24 sm:w-28 sm:h-28 rounded-2xl bg-white/10 border border-white/15 backdrop-blur-md p-2 flex items-center justify-center shadow-inner">
          <img
            src="/assets/icub.png"
            alt="iCub Humanoid Robot in pyCub"
            width="160"
            height="160"
            loading="eager"
            class="w-full h-full object-contain drop-shadow-md"
          />
        </div>
        <div class="space-y-1.5">
          <h2 class="text-xl sm:text-2xl font-brand text-white tracking-tight">
            {t.banner.showcaseTitle}
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 max-w-2xl">
            {t.banner.showcaseSubtitle}
          </p>
          <div class="flex flex-wrap justify-center sm:justify-start gap-2 pt-2">
            {t.banner.quickLinks.map((ql) => (
              <a
                href={ql.url}
                target={ql.external ? "_blank" : undefined}
                rel={ql.external ? "noopener noreferrer" : undefined}
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-white/10 hover:bg-primary border border-white/15 hover:border-primary-light/50 text-white transition-all"
              >
                <span>{ql.label}</span>
                {ql.external && <ExternalLink class="w-3 h-3 opacity-75" />}
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="hidden xl:flex items-center gap-3 flex-shrink-0">
        <img
          src="/assets/logo.png"
          alt="pyCub Studio icon"
          width="64"
          height="64"
          class="w-16 h-16 rounded-2xl bg-white/10 p-1.5 border border-white/20 shadow-md object-contain"
        />
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-install-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy || "pip install pycub-studio";
      try {
        await navigator.clipboard.writeText(text);
        const copyIcon = btn.querySelector(".copy-icon");
        const checkIcon = btn.querySelector(".check-icon");
        const feedback = btn.querySelector(".copy-feedback");
        const prev = feedback?.textContent || "";
        copyIcon?.classList.add("hidden");
        checkIcon?.classList.remove("hidden");
        if (feedback) feedback.textContent = btn.dataset.labelCopied || "Copied!";
        setTimeout(() => {
          copyIcon?.classList.remove("hidden");
          checkIcon?.classList.add("hidden");
          if (feedback) feedback.textContent = prev;
        }, 1800);
      } catch {
        /* ignore clipboard errors in restricted contexts */
      }
    });
  });
</script>
